+/* ---- the same loop again, a block of vertices per instruction -------------
+ *
+ * vsh_run_sse decodes its way through the program once per vertex: for every
+ * instruction three source selections, a switch on the operation and a chain
+ * of write tests, all data dependent. That dispatch was half the executor
+ * thread in the browser (profile of 2026-10-11). Here the instruction loop is
+ * outside and the vertices inside, so each of those decisions is taken once
+ * per NV2A_VSH_BATCH vertices. Every vertex still sees exactly vsh_run_sse's
+ * operations in vsh_run_sse's order, so the outputs are bit-identical
+ * (RECOMP_VSH_BATCHCHECK=1 compares them). A program that writes constants
+ * makes one vertex depend on the one before it and is not run this way. */
+static __forceinline __m128 vsh_swz(__m128 x, __m128i shuf, __m128 sign)
+{
+    return _mm_xor_ps(_mm_castsi128_ps(_mm_shuffle_epi8(_mm_castps_si128(x), shuf)), sign);
+}
+
+static __forceinline void vsh_read_batch(const VshDec *d, const VshVec *v, int k,
+                                         const float (*in)[NV2A_VSH_INPUTS][4],
+                                         __m128 (*temp)[NV2A_VSH_BATCH],
+                                         const int *a0, uint32_t n, __m128 *dst)
+{
+    const VshSrc *sr = &d->src[k];
+    const __m128i shuf = v->shuf[k];
+    const __m128 sign = v->sign[k];
+    uint32_t j;
+
+    if (sr->mux == 1) {
+        const __m128 *t = temp[sr->reg];
+        for (j = 0; j < n; j++)
+            dst[j] = vsh_swz(t[j], shuf, sign);
+    } else if (sr->mux == 2) {
+        for (j = 0; j < n; j++)
+            dst[j] = vsh_swz(_mm_loadu_ps(in[j][d->in_idx]), shuf, sign);
+    } else if (!d->rel) {
+        int ci = (int)d->cidx;
+        __m128 x;
+        if (ci >= NV2A_VSH_CONSTANTS)
+            ci = 0;
+        x = vsh_swz(_mm_loadu_ps(s_const[ci]), shuf, sign);
+        for (j = 0; j < n; j++)
+            dst[j] = x;
+    } else {
+        for (j = 0; j < n; j++) {
+            int ci = (int)d->cidx + a0[j];
+            if (ci < 0 || ci >= NV2A_VSH_CONSTANTS)
+                ci = 0;
+            dst[j] = vsh_swz(_mm_loadu_ps(s_const[ci]), shuf, sign);
+        }
+    }
+}
