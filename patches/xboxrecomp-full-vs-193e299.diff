+/* Where a GET_REPORT (visibility-test result) goes.
+ *
+ * D3D builds the parameter from its report slot's window address as
+ * (va & 0x0EFFFFFF) | 0x01000000: address bits 0-23 and 25-27, with bit 24
+ * forced on as the "pixel count" type. Only the low 24 bits were taken as
+ * the offset, which dropped bits 25-27. Halo 2's second D3D device lives just
+ * above the title's 51 MB pool pinned at physical 0x61000 (its last block
+ * ends at 0x8366C000), so every report for slot 0x8366C0xx landed at
+ * 0x8066C0xx instead -- inside the pool, on Cairo Station's tag data. That
+ * zeroed an object definition (0x8066C168); object creation then took a
+ * garbage size, ran a zeroing loop over the rest of memory, and crashed at
+ * the station door. D3D's own slots never got a result either, so its
+ * occlusion queries read stale answers.
+ *
+ * Bit 24 cannot be told from the type flag by the number alone. The slot is
+ * D3D's own allocation, never inside a range the title pinned at a fixed
+ * address: of the two candidates take the one outside the pinned pool,
+ * preferring bit 24 as sent. */
+static uint32_t report_resolve(uint32_t base, uint32_t param)
+{
+    extern int xbox_ContiguousPinned(uint32_t va);
+    uint32_t hi = base + (param & 0x0FFFFFFFu);   /* bit 24 as sent */
+    uint32_t lo = base + (param & 0x0EFFFFFFu);   /* bit 24 clear */
+    uint32_t pa = hi;
+    if ((uint64_t)hi < XBOX_CONTIG_SIZE && xbox_ContiguousPinned(XBOX_CONTIG_BASE + hi)
+            && !xbox_ContiguousPinned(XBOX_CONTIG_BASE + lo))
+        pa = lo;
+    if ((uint64_t)pa < XBOX_CONTIG_SIZE)
+        return XBOX_CONTIG_BASE + pa;
+    return dma_resolve(pa);
+}
