  * Throttle (timing control for frame pacing)
  * ============================================================ */
 
+/* Answer the GP doorbell, and if a command was there keep looking for a
+ * moment with the lock released: DirectSound posts its commands in bursts
+ * (two or three a game frame, back to back) and spins on each one
+ * (0x37E390), so the ones behind the first are answered in microseconds
+ * instead of at the next 1 ms slice. */
+static void apu_ack_burst(MCPXAPUState *d)
+{
+    uint64_t before = g_apu_gps_acks;
+    int64_t t_end;
+
+    mcpx_apu_dsp_ack_poll(d);
+    if (g_apu_gps_acks == before)
+        return;
+    qemu_mutex_unlock(&d->lock);
+    t_end = qemu_clock_get_us(QEMU_CLOCK_REALTIME) + 300;
+    while (qemu_clock_get_us(QEMU_CLOCK_REALTIME) < t_end) {
+        before = g_apu_gps_acks;
+        mcpx_apu_dsp_ack_poll(d);
+        if (g_apu_gps_acks != before)
+            t_end = qemu_clock_get_us(QEMU_CLOCK_REALTIME) + 300;
+        else
+            SwitchToThread();
+    }
+    qemu_mutex_lock(&d->lock);
+}
