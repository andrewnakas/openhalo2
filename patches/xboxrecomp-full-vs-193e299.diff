+/* ── Sanitizer (RECOMP_SANITIZE) ─────────────────────────────
+ *
+ * RECOMP_SANITIZE=1 in the environment makes the first violation fatal: the
+ * report names the guest site and its return chain, then an access violation
+ * is raised so the port's crash handler adds the full register/stack dump.
+ * Without it each check logs and the run carries on (the old behaviour). The
+ * per-call ABI check needs the build flag -DRECOMP_SANITIZE as well; the bulk
+ * write guard and strict indirect calls work in every build. */
+int recomp_sanitize_fatal(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        /* RECOMP_SANITIZE=log: report every violation once, never stop
+         * (crash shield and skips as normal) -- one run lists them all. */
+        const char *e = getenv("RECOMP_SANITIZE");
+        on = (e && *e && *e != '0' && strcmp(e, "log") != 0);
+        if (on)
+            fprintf(stderr, "[SAN] sanitizer on: first violation stops the run\n");
+        else if (e && !strcmp(e, "log"))
+            fprintf(stderr, "[SAN] sanitizer in log mode: violations reported, run continues\n");
+    }
+    return on;
+}
