+/* ---- Framebuffer objects ------------------------------------------------ */
+
+static GLuint fbo_for(GLuint color, GLuint depth)
+{
+    int i;
+    GLuint f;
+
+    for (i = 0; i < s_nfbo; i++)
+        if (s_fbo[i].color == color && s_fbo[i].depth == depth)
+            return s_fbo[i].fbo;
+    if (s_nfbo == GL_FBO_SLOTS) {
+        for (i = 0; i < s_nfbo; i++)
+            glDeleteFramebuffers(1, &s_fbo[i].fbo);
+        s_nfbo = 0;
+    }
+    glGenFramebuffers(1, &f);
+    glBindFramebuffer(GL_FRAMEBUFFER, f);
+    if (color)
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_2D, color, 0);
+    else {
+        glDrawBuffer(GL_NONE);
+        glReadBuffer(GL_NONE);
+    }
+    if (depth)
+        glFramebufferTexture2D(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT,
+                               GL_TEXTURE_2D, depth, 0);
+    if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+        static unsigned said;
+        if (said++ < 4)
+            fprintf(stderr, "  [GL] framebuffer incomplete (colour %u depth %u)\n",
+                    color, depth);
+    }
+    s_fbo[s_nfbo].color = color;
+    s_fbo[s_nfbo].depth = depth;
+    s_fbo[s_nfbo].fbo = f;
+    s_nfbo++;
+    return f;
+}
+
+static void fbo_forget(GLuint tex)
+{
+    int i;
+    for (i = 0; i < s_nfbo; ) {
+        if (s_fbo[i].color == tex || s_fbo[i].depth == tex) {
+            glDeleteFramebuffers(1, &s_fbo[i].fbo);
+            s_fbo[i] = s_fbo[--s_nfbo];
+        } else {
+            i++;
+        }
+    }
+}
