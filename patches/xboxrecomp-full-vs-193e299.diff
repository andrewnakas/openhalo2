+static double now_us(void)
+{
+    static LARGE_INTEGER f;
+    LARGE_INTEGER c;
+    if (!f.QuadPart)
+        QueryPerformanceFrequency(&f);
+    QueryPerformanceCounter(&c);
+    return (double)c.QuadPart * 1e6 / (double)f.QuadPart;
+}
+/* A draw reads the clock about ten times, and in the browser each read is a
+ * call out of the module (5% of the executor thread, profile of 2026-10-11).
+ * So only one draw in PT_EVERY is timed and its times count PT_EVERY-fold;
+ * the counts stay exact. Outside nv2a_gl_draw everything is timed. */
+#define PT_EVERY 16
