+static int vsh_run_sse_batch(const float (*in)[NV2A_VSH_INPUTS][4],
+                             Nv2aVshOutput *const *out, uint32_t n)
+{
+    __m128 temp[13][NV2A_VSH_BATCH], outregs[13][NV2A_VSH_BATCH];
+    __m128 A[NV2A_VSH_BATCH], B[NV2A_VSH_BATCH], C[NV2A_VSH_BATCH];
+    __m128 M[NV2A_VSH_BATCH], I[NV2A_VSH_BATCH];
+    int a0[NV2A_VSH_BATCH];
+    const __m128 zero = _mm_setzero_ps(), one = _mm_set1_ps(1.0f);
+    const __m128 w1 = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
+    uint32_t s, i, j;
+
+    for (i = 0; i < 13; i++) {
+        const __m128 o = (i == 3 || i == 4 || i >= 9) ? w1 : zero;
+        for (j = 0; j < n; j++) {
+            temp[i][j] = zero;
+            outregs[i][j] = o;
+        }
+    }
+    for (j = 0; j < n; j++) {
+        a0[j] = 0;
+        A[j] = B[j] = C[j] = M[j] = I[j] = zero;
+    }
+
+    for (s = 0; s < s_dec_n; s++) {
+        const VshDec *d = &s_dec[s];
+        const VshVec *v = &s_vec[s];
+        const uint32_t mac = d->mac, ilu = d->ilu;
+        float f[4], g[4];
+
+        /* An operand the instruction does not read is zero in vsh_run_sse. */
+        if (d->need & 1) vsh_read_batch(d, v, 0, in, temp, a0, n, A);
+        else for (j = 0; j < n; j++) A[j] = zero;
+        if (d->need & 2) vsh_read_batch(d, v, 1, in, temp, a0, n, B);
+        else for (j = 0; j < n; j++) B[j] = zero;
+        if (d->need & 4) vsh_read_batch(d, v, 2, in, temp, a0, n, C);
+        else for (j = 0; j < n; j++) C[j] = zero;
+
+        switch (mac) {
+        case 0: for (j = 0; j < n; j++) M[j] = zero; break;
+        case 2: for (j = 0; j < n; j++) M[j] = _mm_mul_ps(A[j], B[j]); break;
+        case 3: for (j = 0; j < n; j++) M[j] = _mm_add_ps(A[j], C[j]); break;
+        case 4: for (j = 0; j < n; j++)
+                    M[j] = _mm_add_ps(_mm_mul_ps(A[j], B[j]), C[j]);
+                break;
+        case 5: for (j = 0; j < n; j++) {
+                    _mm_storeu_ps(f, _mm_mul_ps(A[j], B[j]));
+                    M[j] = _mm_set1_ps(f[0] + f[1] + f[2]);
+                }
+                break;
+        case 6: for (j = 0; j < n; j++) {
+                    _mm_storeu_ps(f, _mm_mul_ps(A[j], B[j])); _mm_storeu_ps(g, B[j]);
+                    M[j] = _mm_set1_ps(f[0] + f[1] + f[2] + g[3]);
+                }
+                break;
+        case 7: for (j = 0; j < n; j++) {
+                    _mm_storeu_ps(f, _mm_mul_ps(A[j], B[j]));
+                    M[j] = _mm_set1_ps(f[0] + f[1] + f[2] + f[3]);
+                }
+                break;
+        case 8: for (j = 0; j < n; j++) {
+                    _mm_storeu_ps(f, A[j]); _mm_storeu_ps(g, B[j]);
+                    M[j] = _mm_set_ps(g[3], f[2], f[1] * g[1], 1.0f);
+                }
+                break;
+        case 9:  for (j = 0; j < n; j++)
+                     M[j] = vsh_blend(B[j], A[j], _mm_cmplt_ps(A[j], B[j]));
+                 break;
+        case 10: for (j = 0; j < n; j++)
+                     M[j] = vsh_blend(B[j], A[j], _mm_cmpge_ps(A[j], B[j]));
+                 break;
+        case 11: for (j = 0; j < n; j++)
+                     M[j] = _mm_and_ps(_mm_cmplt_ps(A[j], B[j]), one);
+                 break;
+        case 12: for (j = 0; j < n; j++)
+                     M[j] = _mm_and_ps(_mm_cmpge_ps(A[j], B[j]), one);
+                 break;
+        case 13: for (j = 0; j < n; j++) {
+                     _mm_storeu_ps(f, A[j]);
+                     a0[j] = (int)floorf(f[0] + 0.001f);
+                 }
+                 /* fall through: the result is A, as for mov */
+        default: for (j = 0; j < n; j++) M[j] = A[j]; break;
+        }
+        if (ilu) {
+            for (j = 0; j < n; j++) {
+                vec4 cv, rv;
+                _mm_storeu_ps(cv.v, C[j]);
+                rv = run_ilu(ilu, cv);
+                I[j] = _mm_loadu_ps(rv.v);
+            }
+        } else {
+            for (j = 0; j < n; j++) I[j] = zero;
+        }
+
+        if (mac && mac != 13 && d->mac_mask && d->tdst <= 12) {
+            __m128 *t = temp[d->tdst];
+            for (j = 0; j < n; j++)
+                t[j] = vsh_blend(t[j], M[j], v->mac_wr);
+        }
+        if (ilu && d->ilu_mask) {
+            uint32_t it = mac ? 1u : d->tdst;     /* see the scalar loop */
+            if (it <= 12) {
+                __m128 *t = temp[it];
+                for (j = 0; j < n; j++)
+                    t[j] = vsh_blend(t[j], I[j], v->ilu_wr);
+            }
+        }
+        if (d->omask && d->out_o) {               /* c[] writes: not in this path */
+            const __m128 *src = d->out_ilu ? I : M;
+            __m128 *t = d->oaddr == 0 ? temp[12]
+                      : d->oaddr < 13 ? outregs[d->oaddr] : NULL;
+            if (t)
+                for (j = 0; j < n; j++)
+                    t[j] = vsh_blend(t[j], src[j], v->out_wr);
+        }
+        if (d->final) {
+            for (j = 0; j < n; j++) {
+                Nv2aVshOutput *o = out[j];
+                _mm_storeu_ps(o->pos, temp[12][j]);
+                _mm_storeu_ps(o->d0, outregs[3][j]);
+                _mm_storeu_ps(o->d1, outregs[4][j]);
+                _mm_storeu_ps(o->fog, outregs[5][j]);
+                _mm_storeu_ps(o->tex[0], outregs[9][j]);
+                _mm_storeu_ps(o->tex[1], outregs[10][j]);
+                _mm_storeu_ps(o->tex[2], outregs[11][j]);
+                _mm_storeu_ps(o->tex[3], outregs[12][j]);
+            }
+            return 1;
+        }
+    }
+    return 0;
+}
