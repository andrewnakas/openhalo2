diff --git a/src/kernel/nv2a_reg_trap.c b/src/kernel/nv2a_reg_trap.c
new file mode 100644
index 0000000..a021daa
--- /dev/null
+++ b/src/kernel/nv2a_reg_trap.c
@@ -0,0 +1,251 @@
+/*
+ * nv2a_reg_trap.c -- exact behaviour for the few NV2A registers a title
+ * handshakes with.
+ *
+ * The register aperture is plain memory, and nv2a_ack_thread clears "busy"
+ * and "interrupt pending" bits from the side. That thread also runs the
+ * pushbuffer executor, so an acknowledgement arrives only between rasterised
+ * frames. Halo 2 shows what that costs (sampled, 2026-10-09): its main thread
+ * sat in
+ *
+ *     or   [regs+0x100410], 0x10000        ; PFB flush
+ *  L: test [regs+0x100410], 0x10000
+ *     jne  L
+ *
+ * for 95% of its time, and the vertical-blank service routine sat in
+ *
+ *  L: mov  [regs+0x600100], 1              ; acknowledge PCRTC
+ *     test [regs+0x000100], 0x01000000     ; PMC still reports PCRTC?
+ *     jne  L
+ *
+ * on the timer thread for the rest of each frame. Polling also cannot model
+ * write-one-to-clear at all: the acknowledging write stores the value that is
+ * already there, and a faster poll would clear a pending bit before the
+ * service routine had read it.
+ *
+ * So the three pages those registers live in are left inaccessible and every
+ * access is serviced here (the same scheme as the OHCI and APU models):
+ *
+ *   PMC    0x000000  INTR_0 (0x100) is derived: bit 24 while PCRTC is pending
+ *   PFB    0x100000  0x100410 bit 16 (flush) completes at once
+ *   PCRTC  0x600000  INTR_0 (0x100) is write-one-to-clear
+ *
+ * Every other register in those pages is stored and read back unchanged.
+ * Off unless a title calls xbox_Nv2aRegTrapInit; RECOMP_NO_NV2A_TRAP keeps the
+ * old polling for comparison.
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#if defined(_WIN32)
+#include <windows.h>
+#include "../platform/mmio_decode.h"
+#endif
+
+#include "nv2a_reg_trap.h"
+
+ptrdiff_t xbox_GetMemoryOffset(void);
+
+#define NV2A_APERTURE   0xFD000000u
+#define TRAP_PAGES      3
+#define PAGE_BYTES      0x1000u
+
+#define OFF_PMC_INTR    0x000100u
+#define OFF_PFB_FLUSH   0x100410u
+#define OFF_PCRTC_INTR  0x600100u
+
+static const uint32_t s_page_off[TRAP_PAGES] = { 0x000000u, 0x100000u, 0x600000u };
+static volatile uint32_t s_shadow[TRAP_PAGES][PAGE_BYTES / 4];
+static int s_active;
+static volatile LONG s_faults, s_undecoded;
+
+static int page_of(uint32_t off)
+{
+    int i;
+    for (i = 0; i < TRAP_PAGES; i++)
+        if (off >= s_page_off[i] && off < s_page_off[i] + PAGE_BYTES)
+            return i;
+    return -1;
+}
+
+int xbox_Nv2aRegTrapActive(void)
+{
+    return s_active;
+}
+
+int xbox_Nv2aRegTrapOwns(uint32_t xbox_va)
+{
+    return s_active && xbox_va >= NV2A_APERTURE
+        && page_of(xbox_va - NV2A_APERTURE) >= 0;
+}
+
+static uint32_t reg_read32(uint32_t off)
+{
+    int p = page_of(off);
+    off &= ~3u;
+    if (off == OFF_PMC_INTR)
+        return s_shadow[2][(OFF_PCRTC_INTR & 0xFFFu) / 4] ? (1u << 24) : 0u;
+    return s_shadow[p][(off & 0xFFFu) / 4];
+}
+
+static void reg_write32(uint32_t off, uint32_t v)
+{
+    int p = page_of(off);
+    off &= ~3u;
+    if (off == OFF_PMC_INTR)
+        return;                                  /* derived, read-only */
+    if (off == OFF_PCRTC_INTR) {
+#if defined(_WIN32)
+        _InterlockedAnd((volatile LONG *)&s_shadow[p][(off & 0xFFFu) / 4],
+                        (LONG)~v);
+#else
+        s_shadow[p][(off & 0xFFFu) / 4] &= ~v;
+#endif
+        return;
+    }
+    if (off == OFF_PFB_FLUSH)
+        v &= ~0x00010000u;                       /* the flush is already done */
+    s_shadow[p][(off & 0xFFFu) / 4] = v;
+}
+
+uint32_t xbox_Nv2aRegRead(uint32_t off)
+{
+    if (s_active && page_of(off) >= 0)
+        return reg_read32(off);
+    return *(volatile uint32_t *)((uintptr_t)xbox_GetMemoryOffset()
+                                  + NV2A_APERTURE + off);
+}
+
+void xbox_Nv2aRegWrite(uint32_t off, uint32_t v)
+{
+    if (s_active && page_of(off) >= 0) {
+        reg_write32(off, v);
+        return;
+    }
+    *(volatile uint32_t *)((uintptr_t)xbox_GetMemoryOffset()
+                           + NV2A_APERTURE + off) = v;
+}
+
+void xbox_Nv2aRaiseVblank(void)
+{
+    if (s_active) {
+#if defined(_WIN32)
+        _InterlockedOr((volatile LONG *)&s_shadow[2][(OFF_PCRTC_INTR & 0xFFFu) / 4], 1);
+#else
+        s_shadow[2][(OFF_PCRTC_INTR & 0xFFFu) / 4] |= 1u;
+#endif
+        return;
+    }
+    /* Plain memory: both bits, as before; the acknowledge thread clears them. */
+    *(volatile uint32_t *)((uintptr_t)xbox_GetMemoryOffset()
+                           + NV2A_APERTURE + OFF_PCRTC_INTR) |= 1u;
+    *(volatile uint32_t *)((uintptr_t)xbox_GetMemoryOffset()
+                           + NV2A_APERTURE + OFF_PMC_INTR) |= (1u << 24);
+}
+
+#if defined(_WIN32)
+
+/* mmio_decode callbacks: off is the aperture offset; sizes 1, 2 and 4. */
+static uint64_t trap_rd(void *dev, uint32_t off, int size)
+{
+    uint32_t v = reg_read32(off) >> ((off & 3u) * 8);
+    (void)dev;
+    if (size == 1) return v & 0xFFu;
+    if (size == 2) return v & 0xFFFFu;
+    return v;
+}
+
+static void trap_wr(void *dev, uint32_t off, uint64_t val, int size)
+{
+    (void)dev;
+    if (size >= 4) {
+        reg_write32(off, (uint32_t)val);
+    } else {
+        /* A narrow write changes only its own bytes. For the write-one-to-
+         * clear register that means the other bytes are written as zero. */
+        uint32_t shift = (off & 3u) * 8;
+        uint32_t mask = (size == 1 ? 0xFFu : 0xFFFFu) << shift;
+        uint32_t part = ((uint32_t)val << shift) & mask;
+        if ((off & ~3u) == OFF_PCRTC_INTR)
+            reg_write32(off, part);
+        else
+            reg_write32(off, (reg_read32(off) & ~mask) | part);
+    }
+}
+
+int xbox_Nv2aRegTrapHandle(void *ctx, uint32_t xbox_va)
+{
+    uint32_t off = xbox_va - NV2A_APERTURE;
+    int ok;
+
+    if (!xbox_Nv2aRegTrapOwns(xbox_va))
+        return 0;
+    InterlockedIncrement(&s_faults);
+    ok = mmio_emulate((PCONTEXT)ctx, off, NULL, trap_rd, trap_wr);
+    if (!ok && InterlockedIncrement(&s_undecoded) <= 20) {
+        const uint8_t *ip = (const uint8_t *)((PCONTEXT)ctx)->Rip;
+        fprintf(stderr, "  [NV2A-REG] undecoded access at +0x%06X: "
+                        "%02X %02X %02X %02X %02X %02X %02X %02X\n",
+                off, ip[0], ip[1], ip[2], ip[3], ip[4], ip[5], ip[6], ip[7]);
+        fflush(stderr);
+    }
+    return ok;
+}
+
+void xbox_Nv2aRegTrapInit(void)
+{
+    uintptr_t base = (uintptr_t)xbox_GetMemoryOffset() + NV2A_APERTURE;
+    int i;
+
+    if (s_active || getenv("RECOMP_NO_NV2A_TRAP"))
+        return;
+    if (!xbox_GetMemoryOffset()) {
+        fprintf(stderr, "  [NV2A-REG] guest memory not mapped yet; trap off\n");
+        return;
+    }
+    /* Whatever start-up seeded there (chip identification and the like) is
+     * what the title must go on reading. */
+    for (i = 0; i < TRAP_PAGES; i++)
+        memcpy((void *)s_shadow[i], (const void *)(base + s_page_off[i]),
+               PAGE_BYTES);
+    s_shadow[0][(OFF_PMC_INTR & 0xFFFu) / 4] = 0;
+    s_shadow[2][(OFF_PCRTC_INTR & 0xFFFu) / 4] = 0;
+    s_shadow[1][(OFF_PFB_FLUSH & 0xFFFu) / 4] &= ~0x00010000u;
+    /* Active before the first page goes away: another thread (the
+     * acknowledge thread polls these registers) can fault the instant a page
+     * is protected, and must find the model already answering. */
+    s_active = 1;
+    for (i = 0; i < TRAP_PAGES; i++) {
+        DWORD old_protect;
+        if (!VirtualProtect((LPVOID)(base + s_page_off[i]), PAGE_BYTES,
+                            PAGE_NOACCESS, &old_protect)) {
+            fprintf(stderr, "  [NV2A-REG] cannot trap +0x%06X (error %lu); "
+                            "trap off\n", s_page_off[i], GetLastError());
+            while (i-- > 0)
+                VirtualProtect((LPVOID)(base + s_page_off[i]), PAGE_BYTES,
+                               PAGE_READWRITE, &old_protect);
+            s_active = 0;
+            return;
+        }
+    }
+    fprintf(stderr, "  [NV2A-REG] PMC, PFB and PCRTC register pages trapped "
+                    "(flush and interrupt acknowledge are exact)\n");
+    fflush(stderr);
+}
+
+void xbox_Nv2aRegTrapReport(void)
+{
+    if (s_active)
+        fprintf(stderr, "  [NV2A-REG] %ld trapped accesses, %ld undecoded\n",
+                (long)s_faults, (long)s_undecoded);
+}
+
+#else
+
+int  xbox_Nv2aRegTrapHandle(void *ctx, uint32_t xbox_va) { (void)ctx; (void)xbox_va; return 0; }
+void xbox_Nv2aRegTrapInit(void) {}
+void xbox_Nv2aRegTrapReport(void) {}
+
+#endif
diff --git a/src/kernel/nv2a_reg_trap.h b/src/kernel/nv2a_reg_trap.h
new file mode 100644
index 0000000..59f8da2
--- /dev/null
+++ b/src/kernel/nv2a_reg_trap.h
@@ -0,0 +1,30 @@
+/* Exact behaviour for the NV2A flush and interrupt-acknowledge registers.
+ * See nv2a_reg_trap.c. */
+#ifndef NV2A_REG_TRAP_H
+#define NV2A_REG_TRAP_H
+
+#include <stdint.h>
+
+/* Start trapping. A title calls this once guest memory is mapped and its
+ * start-up register values are in place; without the call nothing changes. */
+void xbox_Nv2aRegTrapInit(void);
+int  xbox_Nv2aRegTrapActive(void);
+
+/* 1 if the address is in a trapped register page. */
+int  xbox_Nv2aRegTrapOwns(uint32_t xbox_va);
+
+/* Service a trapped access from the title's exception handler. Returns 1 if
+ * the faulting instruction was decoded and stepped over. `ctx` is a PCONTEXT. */
+int  xbox_Nv2aRegTrapHandle(void *ctx, uint32_t xbox_va);
+
+/* For the runtime's own reads and writes of NV2A registers (offset from the
+ * start of the aperture). Works whether or not the page is trapped. */
+uint32_t xbox_Nv2aRegRead(uint32_t off);
+void     xbox_Nv2aRegWrite(uint32_t off, uint32_t value);
+
+/* Mark the vertical blank pending, before its service routine is called. */
+void xbox_Nv2aRaiseVblank(void);
+
+void xbox_Nv2aRegTrapReport(void);
+
+#endif /* NV2A_REG_TRAP_H */
