+void recomp_san_stop(const char *what)
+{
+    fprintf(stderr, "[SAN] STOP: %s\n", what);
+    /* Pointers on the guest stack that point into loaded file data: the read
+     * each came from, and whether that page has changed since. */
+    if (g_xbox_mem_offset && g_esp >= 0x1000u && g_esp < 0x04000000u - 512u) {
+        const uint32_t *sp = (const uint32_t *)((uintptr_t)g_xbox_mem_offset + g_esp);
+        char nm[16];
+        int i;
+        for (i = 0; i < 96; i++) {
+            uint32_t v = sp[i];
+            if ((v >= 0x00010000u && v < 0x04000000u) || (v >= 0x80000000u && v < 0x84000000u)) {
+                snprintf(nm, sizeof nm, "[esp+%X]", i * 4);
+                xbox_ReadAuditWhere(nm, v);
+            }
+        }
+    }
+    fflush(stderr);
+#ifdef _WIN32
+    {
+        ULONG_PTR info[2] = { 1, 0x5A4E };   /* "write" of host 0x5A4E: never shielded */
+        RaiseException(EXCEPTION_ACCESS_VIOLATION, EXCEPTION_NONCONTINUABLE, 2, info);
+    }
