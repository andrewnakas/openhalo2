+    for (i = 0; i < 64; i++)
+        if (pre[kdes_fp[i] - 1])
+            out[i >> 3] |= (uint8_t)(0x80 >> (i & 7));
+}
+
+static void kdes3_schedule(uint8_t table[KDES3_TABLE_BYTES], const uint8_t key[24])
+{
+    kdes_schedule(table, key);
+    kdes_schedule(table + KDES_TABLE_BYTES, key + 8);
+    kdes_schedule(table + 2 * KDES_TABLE_BYTES, key + 16);
+}
+
+static void kdes3_block(const uint8_t table[KDES3_TABLE_BYTES], const uint8_t in[8],
+                        uint8_t out[8], int encrypt)
+{
+    uint8_t a[8], b[8];
+
+    if (encrypt) {
+        kdes_block(table, in, a, 1);
+        kdes_block(table + KDES_TABLE_BYTES, a, b, 0);
+        kdes_block(table + 2 * KDES_TABLE_BYTES, b, out, 1);
+    } else {
+        kdes_block(table + 2 * KDES_TABLE_BYTES, in, a, 0);
+        kdes_block(table + KDES_TABLE_BYTES, a, b, 1);
+        kdes_block(table, b, out, 0);
+    }
+}
+
+/* cipher: 0 = DES, 1 = triple DES. */
+static void kdes_any_block(int cipher, const uint8_t *table, const uint8_t in[8],
+                           uint8_t out[8], int encrypt)
+{
+    if (cipher)
+        kdes3_block(table, in, out, encrypt);
+    else
+        kdes_block(table, in, out, encrypt);
+}
+
+static void kdes_cbc(int cipher, const uint8_t *table, const uint8_t *in, uint8_t *out,
+                     uint32_t len, int encrypt, uint8_t iv[8])
+{
+    uint8_t x[8], c[8];
+    uint32_t o;
+    int i;
+
+    for (o = 0; o + 8 <= len; o += 8) {
+        if (encrypt) {
+            for (i = 0; i < 8; i++) x[i] = (uint8_t)(in[o + i] ^ iv[i]);
+            kdes_any_block(cipher, table, x, c, 1);
+            memcpy(out + o, c, 8);
+            memcpy(iv, c, 8);
+        } else {
+            memcpy(c, in + o, 8);
+            kdes_any_block(cipher, table, c, x, 0);
+            for (i = 0; i < 8; i++) out[o + i] = (uint8_t)(x[i] ^ iv[i]);
+            memcpy(iv, c, 8);
+        }
+    }
+}
+
+/* ---- modular exponentiation on little-endian arrays of 32-bit words ---- */
+
+#define KMOD_MAX_WORDS 256
+
+static int kmod_cmp(const uint32_t *a, const uint32_t *b, uint32_t n)
+{
+    while (n--) {
+        if (a[n] != b[n])
+            return a[n] > b[n] ? 1 : -1;
+    }
+    return 0;
+}
+
+static void kmod_sub(uint32_t *a, const uint32_t *b, uint32_t n)
+{
+    uint64_t borrow = 0;
+    uint32_t i;
+    for (i = 0; i < n; i++) {
+        uint64_t d = (uint64_t)a[i] - b[i] - borrow;
+        a[i] = (uint32_t)d;
+        borrow = (d >> 32) & 1;
+    }
+}
+
+/* r = 2r + bit, reduced; r < m on entry and on return. */
+static void kmod_double(uint32_t *r, int bit, const uint32_t *m, uint32_t n)
+{
+    uint32_t carry = (uint32_t)bit, i;
+    for (i = 0; i < n; i++) {
+        uint32_t top = r[i] >> 31;
+        r[i] = (r[i] << 1) | carry;
+        carry = top;
+    }
+    if (carry || kmod_cmp(r, m, n) >= 0)
+        kmod_sub(r, m, n);
+}
+
+static void kmod_add(uint32_t *r, const uint32_t *a, const uint32_t *m, uint32_t n)
+{
+    uint64_t carry = 0;
+    uint32_t i;
+    for (i = 0; i < n; i++) {
+        uint64_t s = (uint64_t)r[i] + a[i] + carry;
+        r[i] = (uint32_t)s;
+        carry = s >> 32;
+    }
+    if (carry || kmod_cmp(r, m, n) >= 0)
+        kmod_sub(r, m, n);
+}
+
+/* r = a * b mod m; a, b < m; r may not alias a or b. */
+static void kmod_mul(uint32_t *r, const uint32_t *a, const uint32_t *b,
+                     const uint32_t *m, uint32_t n)
+{
+    int i;
+    memset(r, 0, n * sizeof(uint32_t));
+    for (i = (int)n * 32 - 1; i >= 0; i--) {
+        kmod_double(r, 0, m, n);
+        if ((b[i >> 5] >> (i & 31)) & 1)
+            kmod_add(r, a, m, n);
+    }
+}
+
+/* result = base ^ exponent mod modulus; all of n words. Returns 1, or 0 for
+ * a length or modulus it cannot work with. result may alias the inputs. */
+static int kmod_exp(uint32_t *result, const uint32_t *base, const uint32_t *exponent,
+                    const uint32_t *modulus, uint32_t n)
+{
+    static const uint32_t zero[KMOD_MAX_WORDS] = {0};
+    uint32_t b[KMOD_MAX_WORDS], acc[KMOD_MAX_WORDS], t[KMOD_MAX_WORDS];
+    uint32_t e[KMOD_MAX_WORDS], m[KMOD_MAX_WORDS];
+    int i, top;
+
+    if (n == 0 || n > KMOD_MAX_WORDS || kmod_cmp(modulus, zero, n) == 0)
+        return 0;
+    memcpy(e, exponent, n * sizeof(uint32_t));
+    memcpy(m, modulus, n * sizeof(uint32_t));
+
+    /* base mod m, a bit at a time. */
+    memset(b, 0, n * sizeof(uint32_t));
+    for (i = (int)n * 32 - 1; i >= 0; i--)
+        kmod_double(b, (int)((base[i >> 5] >> (i & 31)) & 1), m, n);
+
+    memset(acc, 0, n * sizeof(uint32_t));
+    acc[0] = 1;
+    if (kmod_cmp(acc, m, n) >= 0)
+        acc[0] = 0;                               /* modulus 1 */
+    for (top = (int)n * 32 - 1; top >= 0; top--)
+        if ((e[top >> 5] >> (top & 31)) & 1)
+            break;
+    for (i = top; i >= 0; i--) {
+        kmod_mul(t, acc, acc, m, n);
+        if ((e[i >> 5] >> (i & 31)) & 1)
+            kmod_mul(acc, t, b, m, n);
+        else
+            memcpy(acc, t, n * sizeof(uint32_t));
+    }
+    memcpy(result, acc, n * sizeof(uint32_t));
+    return 1;
+}
+
+#endif /* KERNEL_DES_H */
