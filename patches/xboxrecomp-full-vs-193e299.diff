+}
+
 const float *nv2a_vsh_constant(uint32_t index)
 {
     return s_const[index < NV2A_VSH_CONSTANTS ? index : 0];
@@ -305,12 +322,488 @@ static vec4 run_ilu(uint32_t op, vec4 c)
     return r;
 }
 
+/* The program as the loop wants it: every field pulled out of the four
+ * dwords once. Decoding per vertex (three sources, eight fields each) was
+ * half the executor thread once the pixels moved to the GPU. Semantics are
+ * read_src's and the old loop's, field for field. */
+typedef struct { uint8_t mux, reg, neg, sw[4]; } VshSrc;
+typedef struct {
+    uint8_t mac, ilu, mac_mask, ilu_mask, tdst, omask, oaddr;
+    uint8_t out_ilu, out_o, final, rel, in_idx, cidx;
+    uint8_t need;                   /* sources read: 1 A, 2 B, 4 C */
+    VshSrc src[3];
+} VshDec;
+static VshDec s_dec[NV2A_VSH_SLOTS];
+static uint32_t s_dec_n;
+
+/* ---- the same loop, four components at a time ----------------------------
+ *
+ * Halo 2's title scene runs the program on over 100,000 vertices a frame
+ * (most of what it submits is off screen), which at half a microsecond each
+ * was most of a 30 Hz frame. Registers are __m128; a source read is a load,
+ * one byte shuffle for the swizzle and one XOR for the negate; a masked write
+ * is a blend. Every arithmetic step is the scalar loop's own, in the same
+ * order (dot products are summed left to right, no fused multiply-add), so
+ * the results are bit-identical. ILU ops and ARL stay scalar. */
+/* Also WebAssembly: Emscripten maps these intrinsics onto wasm SIMD (-msse2
+ * -mssse3 -msimd128). The scalar loop there costs most of a frame. */
+#if (defined(_MSC_VER) && (defined(_M_X64) || defined(_M_IX86))) || (defined(__EMSCRIPTEN__) && defined(__SSSE3__))
+#define VSH_SSE 1
+#include <tmmintrin.h>
+#if !defined(_MSC_VER) && !defined(__forceinline)
+#define __forceinline inline __attribute__((always_inline))
+#endif
+
+typedef struct {
+    __m128i shuf[3];
+    __m128  sign[3];
+    __m128  mac_wr, ilu_wr, out_wr;         /* component masks */
+} VshVec;
+static VshVec s_vec[NV2A_VSH_SLOTS];
+
+static __m128 vsh_mask(uint32_t m)             /* x=8 y=4 z=2 w=1 */
+{
+    return _mm_castsi128_ps(_mm_set_epi32((m & 1) ? -1 : 0, (m & 2) ? -1 : 0,
+                                          (m & 4) ? -1 : 0, (m & 8) ? -1 : 0));
+}
+
+static void vsh_sse_prepare(void)
+{
+    uint32_t s, k, i, j;
+    for (s = 0; s < s_dec_n; s++) {
+        const VshDec *d = &s_dec[s];
+        VshVec *v = &s_vec[s];
+        for (k = 0; k < 3; k++) {
+            uint8_t b[16];
+            for (i = 0; i < 4; i++)
+                for (j = 0; j < 4; j++)
+                    b[i * 4 + j] = (uint8_t)(d->src[k].sw[i] * 4 + j);
+            v->shuf[k] = _mm_loadu_si128((const __m128i *)b);
+            v->sign[k] = d->src[k].neg ? _mm_castsi128_ps(_mm_set1_epi32((int)0x80000000u))
+                                       : _mm_setzero_ps();
+        }
+        v->mac_wr = vsh_mask(d->mac_mask);
+        v->ilu_wr = vsh_mask(d->ilu_mask);
+        v->out_wr = vsh_mask(d->omask);
+    }
+}
+
+static __forceinline __m128 vsh_read(const VshDec *d, const VshVec *v, int k,
+                                     const float in[NV2A_VSH_INPUTS][4],
+                                     const __m128 *temp, int a0)
+{
+    const VshSrc *sr = &d->src[k];
+    const float *s;
+    if (sr->mux == 1)
+        s = (const float *)&temp[sr->reg];
+    else if (sr->mux == 2)
+        s = in[d->in_idx];
+    else {
+        int ci = (int)d->cidx;
+        if (d->rel)
+            ci += a0;
+        if (ci < 0 || ci >= NV2A_VSH_CONSTANTS)
+            ci = 0;
+        s = s_const[ci];
+    }
+    return _mm_xor_ps(_mm_castsi128_ps(_mm_shuffle_epi8(
+                          _mm_castps_si128(_mm_loadu_ps(s)), v->shuf[k])),
+                      v->sign[k]);
+}
+
+static __forceinline __m128 vsh_blend(__m128 dst, __m128 src, __m128 mask)
+{
+    return _mm_or_ps(_mm_and_ps(mask, src), _mm_andnot_ps(mask, dst));
+}
+
+static vec4 run_ilu(uint32_t op, vec4 c);
+
+static int vsh_run_sse(const float in[NV2A_VSH_INPUTS][4], Nv2aVshOutput *out)
+{
+    __m128 temp[13], outregs[13];
+    const __m128 zero = _mm_setzero_ps(), one = _mm_set1_ps(1.0f);
+    const __m128 w1 = _mm_set_ps(1.0f, 0.0f, 0.0f, 0.0f);
+    int a0 = 0;
+    uint32_t s, i;
+
+    for (i = 0; i < 13; i++)
+        temp[i] = outregs[i] = zero;
+    outregs[3] = outregs[4] = w1;
+    outregs[9] = outregs[10] = outregs[11] = outregs[12] = w1;
+
+    for (s = 0; s < s_dec_n; s++) {
+        const VshDec *d = &s_dec[s];
+        const VshVec *v = &s_vec[s];
+        uint32_t mac = d->mac, ilu = d->ilu;
+        __m128 a = zero, b = zero, c = zero, mres = zero, ires = zero;
+        float f[4], g[4];
+
+        if (d->need & 1) a = vsh_read(d, v, 0, in, temp, a0);
+        if (d->need & 2) b = vsh_read(d, v, 1, in, temp, a0);
+        if (d->need & 4) c = vsh_read(d, v, 2, in, temp, a0);
+
+        switch (mac) {
+        case 0: break;
+        case 2: mres = _mm_mul_ps(a, b); break;
+        case 3: mres = _mm_add_ps(a, c); break;
+        case 4: mres = _mm_add_ps(_mm_mul_ps(a, b), c); break;
+        case 5: _mm_storeu_ps(f, _mm_mul_ps(a, b));
+                mres = _mm_set1_ps(f[0] + f[1] + f[2]); break;
+        case 6: _mm_storeu_ps(f, _mm_mul_ps(a, b)); _mm_storeu_ps(g, b);
+                mres = _mm_set1_ps(f[0] + f[1] + f[2] + g[3]); break;
+        case 7: _mm_storeu_ps(f, _mm_mul_ps(a, b));
+                mres = _mm_set1_ps(f[0] + f[1] + f[2] + f[3]); break;
+        case 8: _mm_storeu_ps(f, a); _mm_storeu_ps(g, b);
+                mres = _mm_set_ps(g[3], f[2], f[1] * g[1], 1.0f); break;
+        case 9:  mres = vsh_blend(b, a, _mm_cmplt_ps(a, b)); break;
+        case 10: mres = vsh_blend(b, a, _mm_cmpge_ps(a, b)); break;
+        case 11: mres = _mm_and_ps(_mm_cmplt_ps(a, b), one); break;
+        case 12: mres = _mm_and_ps(_mm_cmpge_ps(a, b), one); break;
+        case 13: _mm_storeu_ps(f, a);
+                 a0 = (int)floorf(f[0] + 0.001f);
+                 /* fall through: the result is A, as for mov */
+        default: mres = a; break;
+        }
+        if (ilu) {
+            vec4 cv, rv;
+            _mm_storeu_ps(cv.v, c);
+            rv = run_ilu(ilu, cv);
+            ires = _mm_loadu_ps(rv.v);
+        }
+
+        if (mac && mac != 13 && d->mac_mask && d->tdst <= 12)
+            temp[d->tdst] = vsh_blend(temp[d->tdst], mres, v->mac_wr);
+        if (ilu && d->ilu_mask) {
+            uint32_t it = mac ? 1u : d->tdst;     /* see the scalar loop */
+            if (it <= 12)
+                temp[it] = vsh_blend(temp[it], ires, v->ilu_wr);
+        }
+        if (d->omask) {
+            __m128 src = d->out_ilu ? ires : mres;
+            if (!d->out_o) {                              /* to c[] */
+                if (s_cxt_write && d->oaddr < NV2A_VSH_CONSTANTS)
+                    _mm_storeu_ps(s_const[d->oaddr],
