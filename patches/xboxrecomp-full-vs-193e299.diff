+/* ---- Shadow state -------------------------------------------------------
+ *
+ * A draw sets the same forty-odd pieces of GL state every time, and most of
+ * them have not changed since the draw before. On the desktop a redundant
+ * call is cheap; in a browser every one crosses from WebAssembly into
+ * JavaScript and through WebGL's validation, and state setting was 0.6 s of
+ * every 5 s in a level. Every state call in this file goes through the
+ * wrappers below (the #defines after them), which remember what is set and
+ * skip a call that would change nothing. Deleting a texture or a framebuffer
+ * forgets the bindings, because GL unbinds a deleted object behind our back
+ * and its name may be handed out again. RECOMP_GL_NOCACHE=1 turns the
+ * skipping off. */
+static struct {
+    int     off;                        /* RECOMP_GL_NOCACHE */
+    int     known;
+    GLuint  fbo_draw, fbo_read, prog;
+    GLenum  unit;
+    GLuint  tex2d[8], texcube[8], sampler[8];
+    int     blend, depth, scissor;      /* -1 unknown */
+    GLint   vp[4], sc[4];
+    int     cm[4], dmask;
+    GLenum  dfunc, bsrc, bdst, beq;
+    float   bcol[4];
+} sc;
+
+static void sc_forget(void)
+{
+    const char *e = getenv("RECOMP_GL_NOCACHE");
+    memset(&sc, 0, sizeof sc);
+    sc.off = e && *e && *e != '0';
+    sc.blend = sc.depth = sc.scissor = -1;
+    sc.cm[0] = sc.dmask = -1;
+    sc.vp[2] = sc.sc[2] = -1;
+    sc.unit = 0;
+    sc.fbo_draw = sc.fbo_read = sc.prog = 0xFFFFFFFFu;
+    memset(sc.tex2d, 0xFF, sizeof sc.tex2d);
+    memset(sc.texcube, 0xFF, sizeof sc.texcube);
+    memset(sc.sampler, 0xFF, sizeof sc.sampler);
+    sc.dfunc = sc.bsrc = sc.bdst = sc.beq = 0;
+    sc.bcol[0] = -1.0f;
+    sc.known = 1;
+}
+
+#define SC_READY() do { if (!sc.known) sc_forget(); } while (0)
+
+static void sc_BindFramebuffer(GLenum target, GLuint f)
+{
+    SC_READY();
+    if (!sc.off) {
+        if (target == GL_FRAMEBUFFER && sc.fbo_draw == f && sc.fbo_read == f) return;
+        if (target == GL_DRAW_FRAMEBUFFER && sc.fbo_draw == f) return;
+        if (target == GL_READ_FRAMEBUFFER && sc.fbo_read == f) return;
+    }
+    glBindFramebuffer(target, f);
+    if (target != GL_READ_FRAMEBUFFER) sc.fbo_draw = f;
+    if (target != GL_DRAW_FRAMEBUFFER) sc.fbo_read = f;
+}
+
+static void sc_UseProgram(GLuint prog)
+{
+    SC_READY();
+    if (!sc.off && sc.prog == prog) return;
+    glUseProgram(prog);
+    sc.prog = prog;
+}
+
+static void sc_ActiveTexture(GLenum unit)
+{
+    SC_READY();
+    if (!sc.off && sc.unit == unit) return;
+    glActiveTexture(unit);
+    sc.unit = unit;
+}
+
+static void sc_BindTexture(GLenum target, GLuint tex)
+{
+    unsigned u;
+    SC_READY();
+    if (!sc.unit) { glActiveTexture(GL_TEXTURE0); sc.unit = GL_TEXTURE0; }
+    u = (unsigned)(sc.unit - GL_TEXTURE0) & 7u;
+    if (target == GL_TEXTURE_2D) {
+        if (!sc.off && sc.tex2d[u] == tex) return;
+        sc.tex2d[u] = tex;
+    } else if (target == GL_TEXTURE_CUBE_MAP) {
+        if (!sc.off && sc.texcube[u] == tex) return;
+        sc.texcube[u] = tex;
+    }
+    glBindTexture(target, tex);
+}
+
+static void sc_BindSampler(GLuint unit, GLuint smp)
+{
+    SC_READY();
+    if (!sc.off && unit < 8 && sc.sampler[unit] == smp) return;
+    glBindSampler(unit, smp);
+    if (unit < 8) sc.sampler[unit] = smp;
+}
+
+static int *sc_cap(GLenum cap)
+{
+    return cap == GL_BLEND ? &sc.blend : cap == GL_DEPTH_TEST ? &sc.depth
+         : cap == GL_SCISSOR_TEST ? &sc.scissor : NULL;
+}
+
+static void sc_Enable(GLenum cap)
+{
+    int *c;
+    SC_READY();
+    c = sc_cap(cap);
+    if (!sc.off && c && *c == 1) return;
+    glEnable(cap);
+    if (c) *c = 1;
+}
+
+static void sc_Disable(GLenum cap)
+{
+    int *c;
+    SC_READY();
+    c = sc_cap(cap);
+    if (!sc.off && c && *c == 0) return;
+    glDisable(cap);
+    if (c) *c = 0;
+}
+
+static void sc_Viewport(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+    SC_READY();
+    if (!sc.off && sc.vp[0] == x && sc.vp[1] == y && sc.vp[2] == w && sc.vp[3] == h) return;
+    glViewport(x, y, w, h);
+    sc.vp[0] = x; sc.vp[1] = y; sc.vp[2] = w; sc.vp[3] = h;
+}
+
+static void sc_Scissor(GLint x, GLint y, GLsizei w, GLsizei h)
+{
+    SC_READY();
+    if (!sc.off && sc.sc[0] == x && sc.sc[1] == y && sc.sc[2] == w && sc.sc[3] == h) return;
+    glScissor(x, y, w, h);
+    sc.sc[0] = x; sc.sc[1] = y; sc.sc[2] = w; sc.sc[3] = h;
+}
+
+static void sc_ColorMask(GLboolean r, GLboolean g, GLboolean b, GLboolean a)
+{
+    SC_READY();
+    if (!sc.off && sc.cm[0] == (int)r && sc.cm[1] == (int)g && sc.cm[2] == (int)b && sc.cm[3] == (int)a) return;
+    glColorMask(r, g, b, a);
+    sc.cm[0] = r; sc.cm[1] = g; sc.cm[2] = b; sc.cm[3] = a;
+}
+
+static void sc_DepthMask(GLboolean m)
+{
+    SC_READY();
+    if (!sc.off && sc.dmask == (int)m) return;
+    glDepthMask(m);
+    sc.dmask = m;
+}
+
+static void sc_DepthFunc(GLenum f)
+{
+    SC_READY();
+    if (!sc.off && sc.dfunc == f) return;
+    glDepthFunc(f);
+    sc.dfunc = f;
+}
+
+static void sc_BlendFunc(GLenum a, GLenum b)
+{
+    SC_READY();
+    if (!sc.off && sc.bsrc == a && sc.bdst == b) return;
+    glBlendFunc(a, b);
+    sc.bsrc = a; sc.bdst = b;
+}
+
+static void sc_BlendEquation(GLenum e)
+{
+    SC_READY();
+    if (!sc.off && sc.beq == e) return;
+    glBlendEquation(e);
+    sc.beq = e;
+}
+
+static void sc_BlendColor(GLfloat r, GLfloat g, GLfloat b, GLfloat a)
+{
+    SC_READY();
+    if (!sc.off && sc.bcol[0] == r && sc.bcol[1] == g && sc.bcol[2] == b && sc.bcol[3] == a) return;
+    glBlendColor(r, g, b, a);
+    sc.bcol[0] = r; sc.bcol[1] = g; sc.bcol[2] = b; sc.bcol[3] = a;
+}
+
+static void sc_DeleteTextures(GLsizei n, const GLuint *t)
+{
+    glDeleteTextures(n, t);
+    sc.known = 0;
+}
+
+static void sc_DeleteFramebuffers(GLsizei n, const GLuint *f)
+{
+    glDeleteFramebuffers(n, f);
+    sc.known = 0;
+}
