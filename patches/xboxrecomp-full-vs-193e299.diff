+static uint64_t rotl64(uint64_t x, int r) { return (x << r) | (x >> (64 - r)); }
+
+/* Four multiply-rotate lanes over 32 bytes a step; not cryptographic, only
+ * "did these bytes change". */
+static uint64_t hash_bytes(const uint8_t *p, size_t n)
+{
+    const uint64_t P1 = 0x9E3779B185EBCA87ull, P2 = 0xC2B2AE3D27D4EB4Full;
+    uint64_t a = P1 + P2, b = P2, c = 0, d = 0 - P1, h, w[4];
+    size_t left = n;
+
+    while (left >= 32) {
+        memcpy(w, p, 32);
+        a = rotl64(a + w[0] * P2, 31) * P1;
+        b = rotl64(b + w[1] * P2, 31) * P1;
+        c = rotl64(c + w[2] * P2, 31) * P1;
+        d = rotl64(d + w[3] * P2, 31) * P1;
+        p += 32;
+        left -= 32;
+    }
+    h = rotl64(a, 1) + rotl64(b, 7) + rotl64(c, 12) + rotl64(d, 18) + n;
+    while (left) {
+        h = rotl64(h ^ ((uint64_t)*p++ * P1), 11) * P2;
+        left--;
+    }
+    h ^= h >> 33; h *= P2; h ^= h >> 29;
+    return h;
+}
+
+/* A surface is megabytes and is checked every frame: sample it. */
+static uint64_t hash_sampled(const uint8_t *p, size_t n)
+{
+    const uint64_t P1 = 0x9E3779B185EBCA87ull, P2 = 0xC2B2AE3D27D4EB4Full;
+    uint64_t h = n, w;
+    size_t step, i;
+
+    if (n <= 65536)
+        return hash_bytes(p, n);
+    step = (n / 8192) & ~(size_t)7;
+    if (step < 8)
+        step = 8;
+    for (i = 0; i + 8 <= n; i += step) {
+        memcpy(&w, p + i, 8);
+        h = rotl64(h + w * P2, 31) * P1;
+    }
+    return h;
+}
