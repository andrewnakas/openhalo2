+/* D3D's software interrupt.
+ *
+ * NV097_NO_OPERATION with a non-zero parameter makes the hardware raise a
+ * PGRAPH interrupt with the method and parameter trapped. The D3D8 library
+ * uses it as a fence: it writes the method into the pushbuffer and blocks
+ * until its interrupt service has run the handler for that parameter. Nothing
+ * delivered it, so a title that waits on a fence during device creation stops
+ * there -- Halo 2 does, inside its first BlockOnTime.
+ *
+ * The parameters are queued here and handed to the title's handler from the
+ * timer thread (kernel_d3d_swi_tick), which has a guest stack. One producer
+ * (the executor) and one consumer, so plain indices are enough on x86. */
+#define NV2A_SWI_QUEUE 4096u
+static volatile uint32_t s_swi_head, s_swi_tail;
+static uint32_t s_swi_param[NV2A_SWI_QUEUE];
+/* The handler's arguments travel with the interrupt. D3D passes them in the
+ * two clear-value latches (see nv2a_pb_exec_method), and the handler runs on
+ * another thread: if the executor has moved on by then -- its wait is bounded
+ * -- the latches hold a real clear value, and "write register [0x401A88]"
+ * becomes a write to register 0xFFFFFF00 (seen: a fault at 0xFCFFFF00 in the
+ * handler, one boot in three). So each queued interrupt carries the latches
+ * as they were when it was reached, and they are put back for its handler. */
+static uint32_t s_swi_zclear[NV2A_SWI_QUEUE], s_swi_cclear[NV2A_SWI_QUEUE];
+static volatile uint32_t s_swi_next;          /* next to hand to the handler */
+static uint32_t s_latch_zclear, s_latch_cclear;   /* as the stream last set them */
+
+static void nv2a_latch_write(uint32_t zclear, uint32_t cclear)
+{
+    /* Integer arithmetic: the sum may wrap (see XBOX_WEB_COMPACT). */
+    uintptr_t m = (uintptr_t)xbox_GetMemoryOffset();
+    *(volatile uint32_t *)(m + 0xFD401A88u) = zclear;
+    *(volatile uint32_t *)(m + 0xFD40186Cu) = cclear;
+}
+
+static HANDLE s_swi_done_event;        /* set by nv2a_swi_done */
+/* Profile counters, printed and reset by nv2a_pb_exec_report. */
+uint64_t g_nv2a_prof_swi_ticks, g_nv2a_prof_swi_n;
+uint64_t g_nv2a_prof_scan_ticks, g_nv2a_prof_scan_n, g_nv2a_prof_idle_n;
+static LARGE_INTEGER s_prof_scan_t0;
+void nv2a_prof_scan_begin(void) { QueryPerformanceCounter(&s_prof_scan_t0); }
+void nv2a_prof_scan_end(void)
+{
+    LARGE_INTEGER q;
+    QueryPerformanceCounter(&q);
+    g_nv2a_prof_scan_ticks += (uint64_t)(q.QuadPart - s_prof_scan_t0.QuadPart);
+    g_nv2a_prof_scan_n++;
+}
+
+static void nv2a_swi_post(uint32_t param)
+{
+    uint32_t t = s_swi_tail;
+    if (t - s_swi_head >= NV2A_SWI_QUEUE) {
+        /* Full: this fence is lost, and whatever waits on it waits forever.
+         * Never silently -- a stalled frame loop with no log line is an
+         * afternoon. */
+        static unsigned dropped;
+        if (dropped++ < 8)
+            fprintf(stderr, "  [NV2A] software interrupt 0x%08X DROPPED: queue full (%u pending)" "\n",
+                    param, t - s_swi_head);
+        return;
+    }
+    s_swi_param[t % NV2A_SWI_QUEUE] = param;
+    s_swi_zclear[t % NV2A_SWI_QUEUE] = s_latch_zclear;
+    s_swi_cclear[t % NV2A_SWI_QUEUE] = s_latch_cclear;
+    s_swi_tail = t + 1;
+    {
+        static int tr = -1;
+        if (tr < 0) tr = getenv("RECOMP_SWI_TRACE") != NULL;
+        if (tr) fprintf(stderr, "  [NV2A] software interrupt 0x%08X posted\n", param);
+    }
+
+    /* The hardware raises this interrupt when it reaches the method, and the
+     * FIFO does not move on until the title's service routine has run. Here
+     * the handler runs on the timer thread, so the executor has to wait for
+     * it: carrying on let the rest of the segment execute, GET advance and the
+     * fences be written while the interrupt was still queued. D3D then saw an
+     * idle GPU, tore its device down, and the late handler ran against freed
+     * state -- a wild write that killed Halo 2 at its device re-creation.
+     *
+     * Bounded, because a handler that itself waits on the GPU would otherwise
+     * wait on this thread forever. */
+    {
+        extern void xbox_TimerThreadWake(void);
+        DWORD t0 = GetTickCount();
+        if (!s_swi_done_event)
+            s_swi_done_event = CreateEventA(NULL, FALSE, FALSE, NULL);
+        {
+            LARGE_INTEGER q0, q1;
+            QueryPerformanceCounter(&q0);
+            xbox_TimerThreadWake();
+            while (s_swi_head != s_swi_tail && GetTickCount() - t0 < 200)
+                WaitForSingleObject(s_swi_done_event, 2);
+            QueryPerformanceCounter(&q1);
+            g_nv2a_prof_swi_ticks += (uint64_t)(q1.QuadPart - q0.QuadPart);
+            g_nv2a_prof_swi_n++;
+        }
+        if (s_swi_head != s_swi_tail) {
+            static unsigned said;
+            if (said++ < 4)
+                fprintf(stderr, "  [NV2A] software interrupt 0x%08X not serviced within 200 ms;"
+                                " continuing" "\n", param);
+        }
+    }
+}
+
+/* The fence itself.
+ *
+ * D3D numbers its fences and asks the GPU to store the number of each one it
+ * reaches: NV097_SET_CONTEXT_DMA_SEMAPHORE names a DMA object,
+ * NV097_SET_SEMAPHORE_OFFSET an offset inside it, and
+ * NV097_BACK_END_WRITE_SEMAPHORE_RELEASE writes its parameter there. The
+ * library then compares that word with the fence it wants and blocks while the
+ * GPU is behind. Unhandled, the word never moved, so the first wait never
+ * ended.
+ *
+ * The object's base comes from where the hardware gets it: the handle is
+ * looked up in RAMHT (NV_PFIFO_RAMHT gives its place in instance memory) and
+ * the instance holds the frame and adjust. The title wrote both. */
+static uint32_t s_sem_handle, s_sem_offset;
+static uint32_t s_report_handle;         /* SET_CONTEXT_DMA_REPORT, see GET_REPORT */
+
+static uint32_t s_dma_last_w[4];        /* last object looked up: w0, w1 (limit), w2, inst */
+
+static int dma_object_base(uint32_t handle, uint32_t *base_out)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    const uint32_t regs = 0xFD000000u, ramin = regs + 0x00700000u;
+    uint32_t ramht = *(const uint32_t *)(mem + regs + 0x2210u);
+    uint32_t ht_base = ((ramht >> 4) & 0x1Fu) << 12;
+    uint32_t ht_size = 0x1000u << ((ramht >> 16) & 3u);
+    uint32_t i;
+
+    for (i = 0; i + 8 <= ht_size; i += 8) {
+        uint32_t h   = *(const uint32_t *)(mem + ramin + ht_base + i);
+        uint32_t ctx = *(const uint32_t *)(mem + ramin + ht_base + i + 4);
+        if (h == handle && (ctx & 0x80000000u)) {
+            uint32_t inst = (ctx & 0xFFFFu) << 4;
+            uint32_t w0 = *(const uint32_t *)(mem + ramin + inst);
+            uint32_t w2 = *(const uint32_t *)(mem + ramin + inst + 8);
+            s_dma_last_w[0] = w0;
+            s_dma_last_w[1] = *(const uint32_t *)(mem + ramin + inst + 4);
+            s_dma_last_w[2] = w2;
+            s_dma_last_w[3] = inst;
+            *base_out = (w2 & 0xFFFFF000u) + (w0 >> 20);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void semaphore_release(uint32_t value)
+{
+    uint8_t *mem = (uint8_t *)xbox_GetMemoryOffset();
+    uint32_t base, va;
+    static unsigned shown, missed;
+
+    if (!dma_object_base(s_sem_handle, &base)) {
+        if (missed++ < 3)
+            fprintf(stderr, "  [NV2A] semaphore release %u: DMA object 0x%X not found in RAMHT"
+                            "; the fence word is not written" "\n",
+                    value, s_sem_handle);
+        return;
+    }
+    va = dma_resolve(base + s_sem_offset);
+    *(uint32_t *)(mem + va) = value;
+    if (shown++ < 6)
+        fprintf(stderr, "  [NV2A] semaphore release %u -> 0x%08X (object 0x%X base 0x%08X + 0x%X)" "\n",
+                value, va, s_sem_handle, base, s_sem_offset);
+}
+
+/* Hand the next queued interrupt to the caller, with the latches as they
+ * were when the executor reached it. The executor's wait in nv2a_swi_post
+ * ends at nv2a_swi_done, not here: taking is not having run the handler, and
+ * letting the executor go at the take had it racing the handler it was
+ * waiting for. */
+int nv2a_swi_take(uint32_t *param)
+{
+    uint32_t h = s_swi_next;
+    if (h == s_swi_tail)
+        return 0;
+    *param = s_swi_param[h % NV2A_SWI_QUEUE];
+    nv2a_latch_write(s_swi_zclear[h % NV2A_SWI_QUEUE],
+                     s_swi_cclear[h % NV2A_SWI_QUEUE]);
+    s_swi_next = h + 1;
+    return 1;
+}
+
+/* The handler for everything taken so far has returned (or it was dropped). */
+void nv2a_swi_done(void)
+{
+    nv2a_latch_write(s_latch_zclear, s_latch_cclear);
+    s_swi_head = s_swi_next;
+    if (s_swi_done_event)
+        SetEvent(s_swi_done_event);
+}
+
+/* One more index of the open batch. A batch longer than the buffer is drawn
+ * in pieces: what is held is drawn as it stands, and the vertices the next
+ * piece needs to continue the same primitive are carried over (the last two
+ * of a strip, the hub and the last of a fan). NV_MAX_INDICES is even and a
+ * multiple of 3 and 4, so lists end on a whole primitive and a strip keeps
+ * its winding parity. */
+static void draw_primitive(void);
+static int idx_old_limits(void)
+{
+    /* RECOMP_GPU_OLDIDX=1: the behaviour before the fix (4096 indices a
+     * batch, no ARRAY_ELEMENT32), for before/after pictures. */
+    static int old = -1;
+    if (old < 0)
+        old = getenv("RECOMP_GPU_OLDIDX") != NULL;
+    return old;
+}
+
+static void idx_push(uint32_t ix)
+{
+    if ((idx_old_limits() || s_ab_oldidx) && s_gpu.idx_count >= 4096u)
+        return;
+    if (s_gpu.idx_count >= NV_MAX_INDICES) {
+        uint32_t keep[2], nkeep = 0, n = s_gpu.idx_count;
+        switch (s_gpu.prim) {
+        case NV_PRIM_TRIANGLE_STRIP:
+        case NV_PRIM_QUAD_STRIP:
+            keep[0] = s_gpu.idx[n - 2]; keep[1] = s_gpu.idx[n - 1]; nkeep = 2;
+            break;
+        case NV_PRIM_TRIANGLE_FAN:
+        case NV_PRIM_POLYGON:
+            keep[0] = s_gpu.idx[0]; keep[1] = s_gpu.idx[n - 1]; nkeep = 2;
+            break;
+        case NV_PRIM_LINE_STRIP:
+        case NV_PRIM_LINE_LOOP:
+            keep[0] = s_gpu.idx[n - 1]; nkeep = 1;
+            break;
+        default:
+            break;
+        }
+        if (s_gpu.inline_active || s_gpu.imm_count || s_gpu.inline_count) {
+            s_gpu.idx_lost++;                 /* not an indexed batch: no split */
+            return;
+        }
+        draw_primitive();
+        s_gpu.idx_split++;
+        s_gpu.idx_count = 0;
+        while (s_gpu.idx_count < nkeep) {
+            s_gpu.idx[s_gpu.idx_count] = keep[s_gpu.idx_count];
+            s_gpu.idx_count++;
+        }
+    }
+    s_gpu.idx[s_gpu.idx_count++] = ix;
+}
