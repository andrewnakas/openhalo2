+                extern uint32_t g_nv2a_pb_cur_va, g_nv2a_pb_seg_va;
+                const uint8_t *m8 = (const uint8_t *)xbox_GetMemoryOffset();
+                uint32_t a, lo = g_nv2a_pb_cur_va - 0xC0u;
+                if (lo < g_nv2a_pb_seg_va) lo = g_nv2a_pb_seg_va;
+                fprintf(stderr, "  [GPU]  raw words, segment start 0x%08X, reading at 0x%08X:" "\n",
+                        g_nv2a_pb_seg_va, g_nv2a_pb_cur_va);
