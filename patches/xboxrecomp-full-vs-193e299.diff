+/* Guest bytes this process actually has mapped: low RAM or the contiguous
+ * window. Anything else is refused rather than read. */
+static int range_ok(uint32_t va, uint64_t n)
+{
+    if (!n)
+        return 0;
+    if (va >= 0x1000u && (uint64_t)va + n <= 0x04000000u)
+        return 1;
+    if (va >= XBOX_CONTIG_BASE
+        && (uint64_t)va + n <= (uint64_t)XBOX_CONTIG_BASE + XBOX_CONTIG_SIZE)
+        return 1;
+    return 0;
+}
