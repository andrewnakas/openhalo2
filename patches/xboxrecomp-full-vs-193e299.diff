+static uint32_t *scratch(size_t px)
+{
+    if (px > s_buf_px) {
+        free(s_buf);
+        s_buf = (uint32_t *)malloc(px * 4);
+        s_buf_px = s_buf ? px : 0;
+    }
+    return s_buf;
+}
