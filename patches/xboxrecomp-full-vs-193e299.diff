+/* The dispatch lock: one thread at DISPATCH_LEVEL at a time.
+ *
+ * The console has one processor. Code that raises to DISPATCH_LEVEL cannot be
+ * preempted by another thread or by a DPC, and a DPC cannot start until the
+ * level drops, so XDK drivers protect their lists with nothing but the raise.
+ * Here a raise was a thread-local number: the title's main thread sat "at
+ * DISPATCH_LEVEL" inside the USB driver while the timer thread ran that
+ * driver's DPC, and both popped transfer descriptors off one unlocked free
+ * list and edited the same endpoint queues. Measured on Halo 2: 3 boots in 15
+ * crashed in the DPC following a garbage descriptor link, and 3 more came up
+ * with the gamepad's interrupt endpoint pointing at 0xFFFFFFF0 (a dead pad).
+ *
+ * So crossing into DISPATCH_LEVEL takes this lock and crossing out releases
+ * it: guest raises (KfRaiseIrql, KeRaiseIrqlToDpcLevel), DPCs run by the host
+ * (xbox_IrqlEnterInterrupt(2)), and device ISRs that ask for it
+ * (xbox_IrqlDispatchLock). An ISR delivered at device level by
+ * xbox_IrqlEnterInterrupt(>2) does NOT take it: on hardware it interrupts
+ * DISPATCH_LEVEL code, and D3D waits at raised IRQL for exactly that.
+ *
+ * Bounded, like every other gate on this model: a raise that is never lowered
+ * (a thread that exits raised, a calling-convention fault upstream) must not
+ * stop every DPC for good. After DISPATCH_LOCK_WAIT_MS the waiter goes ahead
+ * without the lock, says so, and nobody waits on that same hold again.
+ *
+ * RECOMP_IRQL_LOCK=0 turns it off (the old behaviour); RECOMP_IRQL_LOCK=2
+ * also prints every contended acquisition. */
+#define DISPATCH_LOCK_WAIT_MS 2000
+static volatile LONG s_dl_owner;            /* thread id, 0 = free          */
+static volatile LONG s_dl_seq;              /* bumped on every acquisition  */
+static volatile LONG s_dl_stuck_seq = -1;   /* the hold that timed out      */
+static volatile LONG s_dl_contended, s_dl_timeouts, s_dl_taken, s_dl_overlaps;
+static volatile uint32_t s_dl_owner_ra;     /* guest return address of the holder */
+static XBOX_THREAD_LOCAL int t_dl_held;
+static int s_dl_mode = -1;
+
+static uint32_t irql_guest_ra(void)
+{
+    return g_esp ? *(uint32_t *)((uintptr_t)g_xbox_mem_offset + g_esp) : 0;
+}
+
+static void dispatch_lock_acquire(void)
+{
+    LONG me = (LONG)GetCurrentThreadId();
+
+    if (s_dl_mode < 0) {
+        const char *e = getenv("RECOMP_IRQL_LOCK");
+        s_dl_mode = e ? atoi(e) : 1;
+    }
+    if (!s_dl_mode)
+        return;
+    if (t_dl_held) {                        /* nested on the same thread */
+        t_dl_held++;
+        return;
+    }
+    if (InterlockedCompareExchange(&s_dl_owner, me, 0) != 0) {
+        LONG n = InterlockedIncrement(&s_dl_contended);
+        DWORD t0 = GetTickCount();
+        unsigned spins = 0;
+
+        if (n <= 8 || s_dl_mode > 1) {
+            fprintf(stderr, "  [IRQL] dispatch lock contended: tid %lu "
+                    "(guest ret %08X) waits for tid %ld (guest ret %08X)\n",
+                    (unsigned long)me, irql_guest_ra(),
+                    (long)s_dl_owner, s_dl_owner_ra);
+            fflush(stderr);
+        }
+        for (;;) {
+            if (InterlockedCompareExchange(&s_dl_owner, me, 0) == 0)
+                break;
+            if (s_dl_stuck_seq == s_dl_seq)
+                return;                     /* a hold already given up on */
+            if (++spins < 4000) {
+                YieldProcessor();
+                if ((spins & 63) == 0)
+                    SwitchToThread();
+            } else {
+                Sleep(1);
+                if (GetTickCount() - t0 > DISPATCH_LOCK_WAIT_MS) {
+                    LONG k = InterlockedIncrement(&s_dl_timeouts);
+                    s_dl_stuck_seq = s_dl_seq;
+                    if (k <= 8) {
+                        fprintf(stderr, "  [IRQL] dispatch lock held over "
+                                "%d ms by tid %ld (guest ret %08X); tid %lu "
+                                "goes ahead without it\n",
+                                DISPATCH_LOCK_WAIT_MS, (long)s_dl_owner,
+                                s_dl_owner_ra, (unsigned long)me);
+                        fflush(stderr);
+                    }
+                    return;
+                }
+            }
+        }
+    }
+    InterlockedIncrement(&s_dl_seq);
+    InterlockedIncrement(&s_dl_taken);
+    s_dl_owner_ra = irql_guest_ra();
+    t_dl_held = 1;
+}
+
+static void dispatch_lock_release(void)
+{
+    if (!t_dl_held)
+        return;
+    if (--t_dl_held == 0)
+        InterlockedExchange(&s_dl_owner, 0);
+}
+
+/* For a device model's ISR that must not run beside DISPATCH_LEVEL code. */
+void xbox_IrqlDispatchLock(void)   { dispatch_lock_acquire(); }
+void xbox_IrqlDispatchUnlock(void) { dispatch_lock_release(); }
+int  xbox_IrqlDispatchHeld(void)   { return t_dl_held > 0; }
+
+/* Around a blocking wait: a thread that sleeps while raised would hold every
+ * DPC out until the wait ends, and the wait is often for one of them.
+ * Returns what to hand back to xbox_IrqlDispatchResume. */
+int xbox_IrqlDispatchSuspend(void)
+{
+    int held = t_dl_held;
+    if (held) {
+        t_dl_held = 0;
+        InterlockedExchange(&s_dl_owner, 0);
+    }
+    return held;
+}
+
+void xbox_IrqlDispatchResume(int held)
+{
+    if (held) {
+        dispatch_lock_acquire();
+        if (t_dl_held)
+            t_dl_held = held;
+    }
+}
+
+void xbox_IrqlDispatchReport(void)
+{
+    fprintf(stderr, "  [IRQL] dispatch lock: %ld taken, %ld contended, "
+            "%ld timed out, %ld unprotected overlaps\n", (long)s_dl_taken,
+            (long)s_dl_contended, (long)s_dl_timeouts, (long)s_dl_overlaps);
+    fflush(stderr);
+}
