+/* The guest return chain from `esp`: words that point into code. */
+void recomp_san_guest_chain(uint32_t esp)
+{
+    const uint32_t *sp;
+    int i, shown = 0;
+    if (!g_xbox_mem_offset || esp < 0x1000u || esp >= 0x04000000u - 1024u)
+        return;
+    sp = (const uint32_t *)((uintptr_t)g_xbox_mem_offset + esp);
+    fprintf(stderr, "[SAN]   guest chain from esp=%08X:", esp);
+    for (i = 0; i < 256 && shown < 16; i++)
+        if (sp[i] > g_xbox_code_lo && sp[i] < g_xbox_code_hi) {
+            fprintf(stderr, " +%X:%08X", i * 4, sp[i]);
+            shown++;
+        }
+    fprintf(stderr, "\n[SAN]   args:");
+    for (i = 0; i < 8; i++)
+        fprintf(stderr, " %08X", sp[i]);
+    fputc('\n', stderr);
+}
