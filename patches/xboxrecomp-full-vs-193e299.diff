new file mode 100644
index 0000000..3eb36a1
--- /dev/null
+++ b/tools/recomp/test_sanitize_emission.py
@@ -0,0 +1,68 @@
+"""The sanitizer hooks the lifter emits (RECOMP_SANITIZE, recomp_types.h).
+
+Halo 2's object allocator was handed a negative size and its `rep stosd`
+zeroed everything from its pool to the end of the 64 MB contiguous window;
+every crash after that read zeros. The guard has to sit in front of every bulk
+write, and every ret has to record its N so a caller can check that esp came
+back exactly where the callee's own epilogue puts it.
+"""
+import re
+import unittest
+
+from .disasm import BasicBlock, Instruction, Operand
+from .lifter import Lifter, lift_basic_block
+
+
+def _lift(*instructions):
+    lifted, _ = lift_basic_block(
+        Lifter(), BasicBlock(start=0x1000, instructions=list(instructions)))
+    return "\n".join(lifted)
+
+
+class RepGuardEmissionTest(unittest.TestCase):
+    def test_every_bulk_write_is_guarded_with_its_site_and_width(self):
+        for text, raw, size in (("rep stosb", "f3aa", 1), ("rep stosw", "66f3ab", 2),
+                                ("rep stosd", "f3ab", 4), ("rep movsb", "f3a4", 1),
+                                ("rep movsw", "66f3a5", 2), ("rep movsd", "f3a5", 4)):
+            with self.subTest(text=text):
+                generated = _lift(Instruction(0x1000, 2, text, "", raw))
+                self.assertIn(f"RECOMP_REP_GUARD(0x00001000u, {size}u);", generated)
+
+    def test_guard_comes_before_the_write(self):
+        generated = _lift(Instruction(0x1000, 2, "rep stosd", "", "f3ab"))
+        self.assertLess(generated.index("RECOMP_REP_GUARD"),
+                        generated.index("MEM32(edi"))
+
+    def test_compares_are_not_guarded(self):
+        # repe cmps / repne scas only read.
+        generated = _lift(Instruction(0x1000, 2, "repne scasb", "", "f2ae"))
+        self.assertNotIn("RECOMP_REP_GUARD", generated)
+
+
+class RetNoteEmissionTest(unittest.TestCase):
+    def test_ret_records_zero(self):
+        generated = _lift(Instruction(0x1000, 1, "ret", "", "c3"))
+        self.assertRegex(generated, r"RECOMP_NOTE_RET\(0u\);.*esp \+= 4; return;")
+
+    def test_ret_n_records_n(self):
+        generated = _lift(Instruction(0x1000, 3, "ret", "0xc", "c20c00",
+                                     operands=[Operand(type="imm", imm=12)]))
+        self.assertRegex(generated, r"RECOMP_NOTE_RET\(12u\);.*esp \+= 16; return;")
+
+
+class SanitizeMacroTest(unittest.TestCase):
+    """The header's ABI macro checks the exact esp a callee's ret produces."""
+
+    def test_macro_checks_exact_esp_when_a_lifted_ret_ran(self):
+        from pathlib import Path
+        header = (Path(__file__).resolve().parents[2]
+                  / "templates" / "runtime" / "recomp_types.h").read_text(encoding="utf-8")
+        block = header[header.index("#if defined(RECOMP_SANITIZE)"):
+                       header.index("#elif defined(RECOMP_ABI_CHECK)")]
+        self.assertIn("g_esp != _ap + 4 + _rn", block)
+        self.assertIn("g_last_ret_n = 0xFFFFFFFFu;", block)
+        self.assertTrue(re.search(r"#define RECOMP_NOTE_RET\(n\) \(g_last_ret_n = \(n\)\)", block))
+
+
+if __name__ == "__main__":
+    unittest.main()
