+/* Which region a guest address is in: [lo, hi), or 0 for "other". */
+static int rep_region(uint32_t a, uint32_t *lo, uint32_t *hi)
+{
+    if (a >= 0x00010000u && a < 0x04000000u) { *lo = 0x00010000u; *hi = 0x04000000u; return 1; }
+    if (a >= 0x80000000u && a < 0x84000000u) { *lo = 0x80000000u; *hi = 0x84000000u; return 2; }
+    return 0;
+}
+
+static int rep_range_ok(uint32_t a, uint64_t bytes, int down, uint32_t size)
+{
+    uint32_t lo, hi;
+    uint64_t first, last;
+    if (bytes >= 0x04000000ull)
+        return 0;                       /* bigger than all of RAM */
+    if (down) { first = (uint64_t)a + size - bytes; last = (uint64_t)a + size; }
+    else      { first = a; last = (uint64_t)a + bytes; }
+    if (!rep_region(a, &lo, &hi))
+        return last <= 0x100000000ull && first < 0x100000000ull;
+    return first >= lo && last <= hi;
+}
+
+/* See RECOMP_REP_GUARD in recomp_types.h. Returns the count to use. */
+uint32_t recomp_rep_guard(uint32_t site, uint32_t dst, uint32_t src,
+                          uint32_t count, uint32_t size)
+{
+    extern RECOMP_TLS int g_df;
+    static volatile LONG said;
+    uint64_t bytes = (uint64_t)count * size;
+    int ok = rep_range_ok(dst, bytes, g_df, size);
+    /* rep movs reads esi; stos leaves it unrelated, so only judge it for movs
+     * (the lifter passes the current esi either way; a stos site cannot be
+     * told apart here, so a wild esi alone never fails a write). */
+    (void)src;
+    if (ok)
+        return count;
+    if (InterlockedIncrement(&said) <= 32 || recomp_sanitize_fatal()) {
+        fprintf(stderr, "[SAN] bulk write at guest 0x%08X: %u x %u bytes to 0x%08X%s "
+                        "leaves its region -- %s\n",
+                site, count, size, dst, g_df ? " (down)" : "",
+                recomp_sanitize_fatal() ? "stopping" : "skipped");
+        recomp_san_guest_chain(g_esp);
+        fflush(stderr);
+    }
+    if (recomp_sanitize_fatal())
+        recomp_san_stop("bulk write out of its region");
+    return 0;
+}
