+/* A uniform is sent only when its bytes differ from what this program was
+ * last given (uniform values belong to the program object and stay). */
+static int uni_changed(void *last, const void *now, size_t n)
+{
+#if NV2A_GLES
+    if (!sc.off && memcmp(last, now, n) == 0)
+        return 0;
+#endif
+    memcpy(last, now, n);
+    return 1;
+}
+
+/* Swap red and blue in n pixels: guest order (B G R A in memory) to and from
+ * the RGBA a GLES transfer takes. A no-op on the desktop, which transfers
+ * BGRA itself. */
+static void px_swap(uint32_t *p, size_t n)
+{
+#if NV2A_GLES
+    size_t i;
+    for (i = 0; i < n; i++) {
+        uint32_t v = p[i];
+        p[i] = (v & 0xFF00FF00u) | ((v & 0x00FF0000u) >> 16) | ((v & 0x000000FFu) << 16);
+    }
+#else
+    (void)p; (void)n;
+#endif
+}
