+            }
+        }
+        if (d->final) {
+            _mm_storeu_ps(out->pos, temp[12]);
+            _mm_storeu_ps(out->d0, outregs[3]);
+            _mm_storeu_ps(out->d1, outregs[4]);
+            _mm_storeu_ps(out->fog, outregs[5]);
+            _mm_storeu_ps(out->tex[0], outregs[9]);
+            _mm_storeu_ps(out->tex[1], outregs[10]);
+            _mm_storeu_ps(out->tex[2], outregs[11]);
+            _mm_storeu_ps(out->tex[3], outregs[12]);
