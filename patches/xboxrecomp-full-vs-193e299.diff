+static void gl_check(const char *what)
+{
+    GLenum e;
+    if (!s_debug)
+        return;
+    while ((e = glGetError()) != 0) {
+        static unsigned said;
+        if (said++ < 40)
+            fprintf(stderr, "  [GL] error 0x%04X after %s\n", e, what);
+    }
