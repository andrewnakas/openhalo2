+static void kdes_key_parity(uint8_t *key, uint32_t len)
+{
+    uint32_t i;
+    for (i = 0; i < len; i++) {
+        uint8_t v = (uint8_t)(key[i] & 0xFE), p = v;
+        p ^= p >> 4; p ^= p >> 2; p ^= p >> 1;
+        key[i] = (uint8_t)(v | ((p & 1) ^ 1));
+    }
