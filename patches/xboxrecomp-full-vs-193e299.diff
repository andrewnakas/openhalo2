+/* Where the executor's time goes, per report interval. */
+enum { PT_DL, PT_UL, PT_SCHK, PT_HASH, PT_DEC, PT_DRAW, PT_QUERY, PT_SNAP,
+       PT_FLIP, PT_RESOLVE, PT_STATE, PT_VBO, PT_CALL, PT_N };
