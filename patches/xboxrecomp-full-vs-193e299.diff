+static double s_pt_scale = 1.0;
+static double pt_now(void)
+{
+    return s_pt_live ? now_us() : 0.0;
+}
+static void pt_add(int k, double t0)
+{
+    if (s_pt_live)
+        s_pt[k].us += (now_us() - t0) * s_pt_scale;
+    s_pt[k].n++;
+}
