  * The NV2A has one level of subroutine, so a CALL inside a call is not
  * followed. Addresses are physical, like PUT's, and reach guest memory the
  * same way: through the contiguous window. */
+static uint32_t s_ring_jump_target;
+
+/* Where the last top-level segment jumped to, or 0 if it did not. Cleared by
+ * the read, so a stale target is never reused. */
+uint32_t nv2a_pb_take_ring_jump(void)
+{
+    uint32_t t = s_ring_jump_target;
+    s_ring_jump_target = 0;
+    return t;
+}
