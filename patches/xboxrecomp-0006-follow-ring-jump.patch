+/* Take a range the title pinned at a fixed physical address out of the arena.
+ *
+ * MmAllocateContiguousMemoryEx with lowest/highest spanning exactly one
+ * allocation is honoured at that address, but nothing told this allocator, so
+ * the bump pointer kept handing out memory inside the pinned block. Halo 2
+ * pins a 51 MB pool at physical 0x61000 after freeing its first D3D device,
+ * then creates the second one: its pushbuffer, framebuffers and fence page all
+ * landed inside the pool. Reading the 13 MB intro movie into the pool then
+ * overwrote the framebuffer (noise on screen), the fence word and DirectSound's
+ * heap (a free-list walk that never ended).
+ *
+ * The bump pointer is moved past the pinned block. Blocks handed out below it
+ * earlier are the caller's business: the title frees what it had there before
+ * it pins, as it would have to on the console. */
+void xbox_ContiguousReserve(uint32_t va, uint32_t size)
+{
+    uint32_t end = (va + size + 4095u) & ~4095u;
+
+    AcquireSRWLockExclusive(&g_contig_lock);
+    if (end > g_contig_next) {
+        if (xbox_HeapReclaimEnabled()) {
+            if (va > g_contig_next)
+                contig_insert(g_contig_block_count, g_contig_next,
+                              va - g_contig_next, 1);
+            contig_insert(g_contig_block_count, va, end - va, 0);
+        }
+        fprintf(stderr, "  [CONTIG] pinned 0x%08X..0x%08X reserved; arena continues at 0x%08X"
+                "\n", va, end, end);
+        fflush(stderr);
+        g_contig_next = end;
+    }
+    ReleaseSRWLockExclusive(&g_contig_lock);
+}
