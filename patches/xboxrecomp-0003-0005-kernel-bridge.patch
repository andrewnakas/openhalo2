@@ -2284,6 +2284,46 @@ static void kernel_vblank_tick(void)
     }
 }
 
+/* Deliver the pushbuffer's software interrupts (see nv2a_swi_post).
+ *
+ * The title's own handler is called directly, with the miniport object the
+ * title registered as its interrupt context in ecx and the trapped parameter
+ * in eax, rather than by raising a PGRAPH interrupt: the interrupt status
+ * registers are plain memory that the acknowledge thread zeroes, so the
+ * service routine's deferred half would find nothing pending. The handler's
+ * address is title-specific; a project sets it with
+ * xbox_SetD3DSoftwareInterruptRoutine, and until it does nothing is delivered. */
+static uint32_t g_xbox_d3d_swi_routine;
+int nv2a_swi_take(uint32_t *param);
+
+void xbox_SetD3DSoftwareInterruptRoutine(uint32_t guest_va)
+{
+    g_xbox_d3d_swi_routine = guest_va;
+}
+
+static void kernel_d3d_swi_tick(void)
+{
+    uint32_t param, kint;
+    recomp_func_t fn;
+    int budget = 32;
+
+    if (!g_xbox_d3d_swi_routine)
+        return;
+    kint = xbox_GetConnectedInterrupt(NV2A_VECTOR);
+    if (!kint)
+        return;
+    fn = recomp_lookup(g_xbox_d3d_swi_routine);
+    if (!fn)
+        return;
+
+    while (budget-- > 0 && nv2a_swi_take(&param)) {
+        g_ecx = BRIDGE_MEM32(kint + 4);
+        g_eax = param;
+        g_esp -= 4; BRIDGE_MEM32(g_esp) = 0;
+        { int _irql = xbox_IrqlEnterInterrupt(16); fn(); xbox_IrqlLeaveInterrupt(_irql); }
+    }
+}
+
 /* Run whatever is queued. Called from the timer thread, which has the guest
  * stack and TIB that a deferred routine needs. */
 static void kernel_drain_dpcs(void)
@@ -2572,6 +2612,7 @@ static DWORD WINAPI kernel_timer_thread(LPVOID unused)
 
         Sleep(10);
         kernel_vblank_tick();  /* the GPU's frame clock */
+        kernel_d3d_swi_tick(); /* pushbuffer fences */
         kernel_drain_dpcs();   /* deferred work, before due timers */
         now = (long long)GetTickCount64();
 
@@ -3880,6 +3921,16 @@ static void bridge_NtFsControlFile(void)
 {
     uint32_t fsctl = STACK_ARG(5);
     uint32_t ios_va = STACK_ARG(4);
+    /* FSCTL_DISMOUNT_VOLUME: XAPI dismounts the utility (cache) partition
+     * after formatting it and treats a failure as a bad hard disk, booting
+     * to the dashboard with XLD_ERROR_INVALID_HARD_DISK. The partitions here
+     * are host directories with nothing mounted, so there is nothing to do. */
+    if (fsctl == 0x00090020u) {
+        fprintf(stderr, "  [FILE] NtFsControlFile(FSCTL_DISMOUNT_VOLUME) - ok\n");
+        bridge_write_iostatus(ios_va, 0, 0);
+        g_eax = 0;
+        return;
+    }
     fprintf(stderr, "  [FILE] NtFsControlFile(0x%X) - stub\n", fsctl);
     bridge_write_iostatus(ios_va, 0xC00000BBu, 0);
     g_eax = 0xC00000BBu;
